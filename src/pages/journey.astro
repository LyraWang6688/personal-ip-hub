---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import TextLink from '../components/TextLink.astro';
import { evidenceChannels } from '../data/evidence-channels';

/**
 * Journey subdomains — IA v1 §8. Journey records *when* a meaningful change
 * happened and references Work / Learning / Writing rather than restating them.
 */
const journeyAreas = [
  'Overall journey',
  'GitHub journey',
  'Public writing journey',
  'Personal IP journey',
  'Milestones',
];
---

<BaseLayout
  title="Journey — Lyra Wang"
  description="When meaningful changes happened — across projects, public writing, and the development of a public identity."
>
  <PageHeader
    eyebrow="Journey"
    title="How this developed over time"
    description="This domain records when a meaningful change happened. It references work, learning, and writing rather than restating their detail, so the same story is not told twice."
  />

  <!--
    Evidence channels (IA v1 §10). GitHub is the only channel with a confirmed
    public URL, so it is the only one rendered. The retired "Digital Footprints"
    domain was a list of platform links; it is not replaced by a Journey that is
    only a link list — the links live here as evidence entry points while the
    Journey structure below carries the timeline semantics.
  -->
  <Section id="evidence">
    <SectionHeader
      title="Public evidence"
      description="Confirmed public channels that carry a trace of the work over time."
    />
    <ul class="channels">
      {
        evidenceChannels.map((channel) => (
          <li class="channel">
            <p class="channel-type metadata">{channel.type}</p>
            <h3 class="channel-label">{channel.label}</h3>
            <p class="channel-description">{channel.description}</p>
            {channel.url && (
              <TextLink href={channel.url} external>
                Visit
              </TextLink>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="areas" className="section-alt">
    <SectionHeader
      title="Areas this domain covers"
      description="Journey is organised by where the change happened, not by platform."
    />

    <ul class="journey-areas">
      {journeyAreas.map((area) => <li class="journey-area">{area}</li>)}
    </ul>

    <EmptyState
      note="No milestones published yet."
      detail="Milestones are added once the date and the change they represent are both confirmed."
    />
  </Section>
</BaseLayout>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-6);
  }
  .channel {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .channel-type {
    margin-bottom: var(--space-3);
  }
  .channel-label {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-2);
  }
  .channel-description {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .journey-areas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-7);
  }
  .journey-area {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-3);
  }

  @media (max-width: 768px) {
    .channels {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .journey-areas {
      grid-template-columns: 1fr;
      margin-bottom: var(--space-6);
    }
  }
</style>
