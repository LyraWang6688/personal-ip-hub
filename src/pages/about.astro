---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import TextLink from '../components/TextLink.astro';
import { evidenceChannels } from '../data/evidence-channels';
---

<BaseLayout
  title="About — Lyra Wang"
  description="Who is behind this work, which public profiles are verified, and how to get in touch."
>
  <PageHeader
    eyebrow="About"
    title="About"
    description="Who is behind this work, what the current focus is, and how to get in touch. This is not a CV, and no claim is made here that is not confirmed."
  />

  <!-- Only profiles with a confirmed public URL are rendered. -->
  <Section id="profiles">
    <SectionHeader
      title="Public profiles"
      description="Public identities that can be checked directly."
    />
    <ul class="channels">
      {
        evidenceChannels.map((channel) => (
          <li class="channel">
            <h3 class="channel-label">{channel.label}</h3>
            <p class="channel-description">{channel.description}</p>
            {channel.url && (
              <TextLink href={channel.url} external>
                {channel.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </TextLink>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="background" className="section-alt">
    <SectionHeader
      title="Background"
      description="The path into this work, and what matters about how it is approached."
    />
    <EmptyState
      note="Not yet published."
      detail="Personal background is added only once the wording has been confirmed — it is not drafted on the site owner's behalf."
    />
  </Section>

  <Section id="contact">
    <SectionHeader
      title="Contact"
      description="The appropriate route for getting in touch."
    />
    <EmptyState
      note="Contact details not published yet."
      detail="A contact address is added once it is confirmed and safe to publish. Public profiles listed above remain available in the meantime."
    />
  </Section>
</BaseLayout>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-6);
  }
  .channel {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .channel-label {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-2);
  }
  .channel-description {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  @media (max-width: 768px) {
    .channels {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
