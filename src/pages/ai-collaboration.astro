---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="AI Collaboration — Lyra Wang" description="How Lyra works with AI — an AI-native working method.">
  <section class="placeholder-page">
    <div class="container">
      <p class="metadata">AI Collaboration</p>
      <h1>How I Work With AI</h1>
      <p class="placeholder-text">
        This page is planned for a future phase. It will detail the AI-native working method —
        Problem Framing, Product / Architecture, AI Developer, Review / QA, Runtime, Feedback, Iteration.
      </p>
      <p class="placeholder-note">Phase 1 delivers a concise preview on the Home page. Full detail comes after Review.</p>
      <Button href="/" variant="secondary">← Back to Home</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-page {
    padding: var(--space-10) 0;
  }
  .placeholder-page .metadata {
    margin-bottom: var(--space-4);
  }
  .placeholder-page h1 {
    margin-bottom: var(--space-5);
  }
  .placeholder-text {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    max-width: var(--container-narrow);
    margin-bottom: var(--space-3);
    line-height: var(--line-height-relaxed);
  }
  .placeholder-note {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    font-style: italic;
  }
</style>
