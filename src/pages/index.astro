---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ReadingItem from '../components/ReadingItem.astro';
import Button from '../components/Button.astro';
import TextLink from '../components/TextLink.astro';
import { projects } from '../data/projects';
import { nowThemes } from '../data/now';
import { readingItems } from '../data/reading';
import { footprints } from '../data/footprints';

const aiWorkflowSteps = [
  'Problem Framing',
  'Product / Architecture',
  'AI Developer',
  'Review / QA',
  'Runtime',
  'Feedback',
  'Iteration',
];
---

<BaseLayout
  title="Lyra Wang — Personal IP Hub"
  description="Lyra Wang's long-term personal digital space: real projects, AI collaboration, ongoing learning, reading, and public writing."
>
  <!-- ============================================================
       01 — Hero
       Who is Lyra?
       ============================================================ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <p class="hero-eyebrow metadata">Personal IP Hub</p>
      <h1 id="hero-heading" class="hero-title">Lyra Wang</h1>
      <p class="hero-identity">Building real things with AI — through projects, practice, and long-term learning.</p>
      <p class="hero-description">
        A long-term personal digital space for what I actually build, how I work with AI,
        what I'm learning right now, and what is shaping my thinking.
        <!-- TODO: Replace with Lyra's confirmed personal bio. Current text is derived from the project brief, not a personal statement. -->
      </p>
      <div class="hero-ctas">
        <Button href="/projects" variant="primary" size="lg">View Projects</Button>
        <Button href="/ai-collaboration" variant="secondary" size="lg">How I Work</Button>
      </div>
    </div>
  </section>

  <!-- ============================================================
       02 — Selected Projects
       What has she actually built?
       ============================================================ -->
  <Section id="projects">
    <SectionHeader
      eyebrow="Selected Projects"
      title="What I've actually built"
      description="Real projects, iterated over time. Each one is a practice ground — not a showcase of tech stacks, but evidence of problems worked through."
    />
    <div class="projects-list">
      {projects.map((project, i) => <ProjectPreview project={project} index={i} />)}
    </div>
    <div class="section-footer-link">
      <TextLink href="/projects">View all projects</TextLink>
    </div>
  </Section>

  <!-- ============================================================
       03 — How I Work With AI
       How does Lyra actually work with AI?
       ============================================================ -->
  <Section id="ai-collaboration" className="section-alt">
    <SectionHeader
      eyebrow="How I Work With AI"
      title="Not just using AI tools — practicing an AI-native working method"
      description="AI is not a logo wall. It is a way of working: framing problems clearly, defining contracts, letting AI implement, reviewing independently, and verifying through real runtime."
    />
    <div class="workflow">
      <ol class="workflow-steps" aria-label="AI collaboration workflow">
        {aiWorkflowSteps.map((step, i) => (
          <li class="workflow-step">
            <span class="workflow-number metadata">{String(i + 1).padStart(2, '0')}</span>
            <span class="workflow-label">{step}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="ai-practices">
      <div class="practice-item">
        <p class="practice-label metadata">In practice</p>
        <ul class="practice-list">
          <li>ChatGPT for problem framing, product and architecture discussion</li>
          <li>Codex / AI Developer for concrete implementation</li>
          <li>Independent Reviewer / QA for review and quality assurance</li>
          <li>Multi-Agent collaboration with defined roles</li>
          <li>Official API documentation + clear context + module boundaries</li>
          <li>Runtime verification of real results, then iteration on feedback</li>
        </ul>
      </div>
    </div>
    <div class="section-footer-link">
      <TextLink href="/ai-collaboration">Read more about how I work</TextLink>
    </div>
  </Section>

  <!-- ============================================================
       04 — Now
       What is Lyra working on and learning now?
       ============================================================ -->
  <Section id="now">
    <SectionHeader
      eyebrow="Now"
      title="What I'm working on and learning — through practice"
      description="Now is not a course list or a certificate wall. It is what I am learning by doing, right now, through real projects."
    />
    <div class="now-grid">
      {nowThemes.map((theme) => (
        <article class="now-card">
          <h3 class="now-title">{theme.title}</h3>
          <p class="now-description">{theme.description}</p>
          <ul class="now-practices">
            {theme.practices.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="now-principle">
      <em>Learning through building. Now = Practice, not courses.</em>
    </p>
    <div class="section-footer-link">
      <TextLink href="/now">See what I'm doing now</TextLink>
    </div>
  </Section>

  <!-- ============================================================
       05 — Reading
       What is shaping her thinking?
       ============================================================ -->
  <Section id="reading" className="section-alt">
    <SectionHeader
      eyebrow="Reading"
      title="What is shaping my thinking right now"
      description="Not a reading count, not a star-rating wall. Just what I'm reading, why now, and what ideas are staying with me."
    />
    <div class="reading-list">
      {readingItems.map((item) => <ReadingItem item={item} />)}
    </div>
    <p class="reading-note caption">
      Placeholder content — real reading data to be confirmed. No books have been fabricated.
    </p>
    <div class="section-footer-link">
      <TextLink href="/reading">View all reading</TextLink>
    </div>
  </Section>

  <!-- ============================================================
       06 — Digital Footprints
       Is there evidence this has been happening over time?
       ============================================================ -->
  <Section id="digital-footprints">
    <SectionHeader
      eyebrow="Digital Footprints"
      title="Time × Evidence"
      description="These are not social media follow buttons. They are public traces left over time — evidence that the work, writing, and learning are real and ongoing."
    />
    <div class="footprints-list">
      {footprints.map((fp) => (
        <div class="footprint-item">
          <p class="footprint-type metadata">{fp.type}</p>
          <h3 class="footprint-label">{fp.label}</h3>
          <p class="footprint-description">{fp.description}</p>
          {fp.url ? (
            <TextLink href={fp.url} external={fp.url.startsWith('http')}>
              Visit
            </TextLink>
          ) : (
            <p class="caption">Link to be confirmed</p>
          )}
        </div>
      ))}
    </div>
    <div class="section-footer-link">
      <TextLink href="/digital-footprints">Explore full timeline</TextLink>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: var(--space-10) 0 var(--space-9);
  }
  .hero-inner {
    max-width: var(--container-narrow);
  }
  .hero-eyebrow {
    margin-bottom: var(--space-5);
  }
  .hero-title {
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--space-5);
  }
  .hero-identity {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-style: italic;
    font-weight: var(--font-weight-regular);
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-bottom: var(--space-5);
    max-width: 32rem;
  }
  .hero-description {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-7);
    max-width: 34rem;
  }
  .hero-ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ---------- Section alt background ---------- */
  .section-alt {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  /* ---------- Projects ---------- */
  .projects-list {
    margin-bottom: var(--space-6);
  }
  .section-footer-link {
    margin-top: var(--space-6);
  }

  /* ---------- AI Workflow ---------- */
  .workflow {
    margin-bottom: var(--space-7);
  }
  .workflow-steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  .workflow-step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }
  .workflow-number {
    color: var(--color-text-muted);
    font-family: var(--font-display);
  }
  .workflow-label {
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-medium);
  }

  .ai-practices {
    max-width: var(--container-narrow);
  }
  .practice-label {
    margin-bottom: var(--space-3);
  }
  .practice-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .practice-list li {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
    line-height: 1.6;
  }
  .practice-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 1px;
    background: var(--color-accent);
  }

  /* ---------- Now ---------- */
  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .now-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .now-title {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-2);
  }
  .now-description {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .now-practices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .now-practices li {
    font-size: var(--font-size-caption);
    color: var(--color-text-secondary);
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }
  .now-principle {
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: var(--space-4);
  }

  /* ---------- Reading ---------- */
  .reading-list {
    margin-bottom: var(--space-4);
  }
  .reading-note {
    margin-bottom: var(--space-4);
    font-style: italic;
  }

  /* ---------- Footprints ---------- */
  .footprints-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .footprint-item {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }
  .footprint-type {
    margin-bottom: var(--space-3);
    text-transform: capitalize;
  }
  .footprint-label {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-2);
  }
  .footprint-description {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-9) 0 var(--space-8);
    }
    .now-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .footprints-list {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .workflow-steps {
      gap: var(--space-2);
    }
    .workflow-step {
      padding: var(--space-2) var(--space-3);
    }
    .hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-ctas .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .now-card {
      padding: var(--space-4);
    }
  }
</style>
