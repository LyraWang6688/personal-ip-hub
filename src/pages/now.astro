---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import NowThemeCard from '../components/NowThemeCard.astro';
import TextLink from '../components/TextLink.astro';
import { nowThemes } from '../data/now';
---

<BaseLayout
  title="Now — Lyra Wang"
  description="What is being worked on and learned right now, through real projects rather than courses or certificates."
>
  <PageHeader
    eyebrow="Now"
    title="What I'm doing now"
    description="A snapshot of current focus. This is a supporting page rather than a primary domain: what is being learned is recorded under Learning, and this page shows where that learning is happening right now."
  />

  <Section id="focus">
    <div class="now-grid">
      {nowThemes.map((theme) => <NowThemeCard theme={theme} />)}
    </div>

    <p class="now-principle">
      <em>Learning through building — practice, not courses.</em>
    </p>

    <TextLink href="/learning">See how learning is recorded</TextLink>
  </Section>
</BaseLayout>

<style>
  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .now-principle {
    font-family: var(--font-display);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  @media (max-width: 768px) {
    .now-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
  }
</style>
