---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Now — Lyra Wang" description="What Lyra is working on and learning right now, through practice.">
  <section class="placeholder-page">
    <div class="container">
      <p class="metadata">Now</p>
      <h1>What I'm doing now</h1>
      <p class="placeholder-text">
        This page is planned for a future phase. It will show what I'm working on and learning —
        through real practice, not courses or certificates.
      </p>
      <p class="placeholder-note">Phase 1 delivers a Now preview on the Home page. Full Now page comes after Review.</p>
      <Button href="/" variant="secondary">← Back to Home</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-page {
    padding: var(--space-10) 0;
  }
  .placeholder-page .metadata {
    margin-bottom: var(--space-4);
  }
  .placeholder-page h1 {
    margin-bottom: var(--space-5);
  }
  .placeholder-text {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    max-width: var(--container-narrow);
    margin-bottom: var(--space-3);
    line-height: var(--line-height-relaxed);
  }
  .placeholder-note {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    font-style: italic;
  }
</style>
