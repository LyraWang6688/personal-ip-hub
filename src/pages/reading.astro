---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Reading — Lyra Wang" description="What Lyra is reading and what is shaping her thinking.">
  <section class="placeholder-page">
    <div class="container">
      <p class="metadata">Reading</p>
      <h1>My Reading</h1>
      <p class="placeholder-text">
        This page is planned for a future phase. It will be a personal reading and thinking space —
        what I'm reading, why now, what ideas stayed with me, and how reading connects to projects.
      </p>
      <p class="placeholder-note">Phase 1 delivers a Reading preview on the Home page with placeholder content. Real reading data and full library come after Review.</p>
      <Button href="/" variant="secondary">← Back to Home</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-page {
    padding: var(--space-10) 0;
  }
  .placeholder-page .metadata {
    margin-bottom: var(--space-4);
  }
  .placeholder-page h1 {
    margin-bottom: var(--space-5);
  }
  .placeholder-text {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    max-width: var(--container-narrow);
    margin-bottom: var(--space-3);
    line-height: var(--line-height-relaxed);
  }
  .placeholder-note {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    font-style: italic;
  }
</style>
