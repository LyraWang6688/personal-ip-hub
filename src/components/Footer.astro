---
import { evidenceChannels, type EvidenceChannel } from '../data/evidence-channels';

const year = new Date().getFullYear();

// Only channels with a confirmed public URL are linked. A channel without one is
// omitted rather than rendered as a "to be confirmed" placeholder.
const publicChannels = evidenceChannels.filter(
  (channel): channel is EvidenceChannel & { url: string } => Boolean(channel.url)
);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-name">Lyra Wang</p>
      <p class="footer-tagline">
        A public record of work, method, learning, and writing.
      </p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <ul>
        {
          publicChannels.map((channel) => (
            <li>
              <a href={channel.url} target="_blank" rel="noopener noreferrer">
                {channel.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p class="copyright">© {year} Lyra Wang. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8) var(--space-6);
    margin-top: var(--space-9);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-2);
  }

  .footer-tagline {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    max-width: 28rem;
    line-height: 1.6;
  }

  .footer-links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-links a {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }
  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .copyright {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
