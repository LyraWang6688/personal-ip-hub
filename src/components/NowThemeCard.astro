---
import type { NowTheme } from '../data/now';

interface Props {
  theme: NowTheme;
}
const { theme } = Astro.props;
---

<article class="now-card">
  <h3 class="now-title">{theme.title}</h3>
  <p class="now-description">{theme.description}</p>
  <ul class="now-practices">
    {theme.practices.map((practice) => <li>{practice}</li>)}
  </ul>
</article>

<style>
  .now-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .now-title {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-2);
  }
  .now-description {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .now-practices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .now-practices li {
    font-size: var(--font-size-caption);
    color: var(--color-text-secondary);
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  @media (max-width: 480px) {
    .now-card {
      padding: var(--space-4);
    }
  }
</style>
