---
/**
 * Page-level header for domain pages. Renders the single <h1> of a page so that
 * every route has exactly one top-level heading, with section headings beneath
 * it provided by SectionHeader (h2).
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow metadata">{eyebrow}</p>}
    <h1 class="page-title">{title}</h1>
    {description && <p class="page-description">{description}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-block: var(--space-9) var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .eyebrow {
    margin-bottom: var(--space-4);
  }
  .page-title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--space-5);
    max-width: 28ch;
  }
  .page-description {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: var(--container-narrow);
  }

  @media (max-width: 768px) {
    .page-header {
      padding-block: var(--space-8) var(--space-6);
    }
  }
</style>
