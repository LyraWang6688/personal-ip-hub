---
import { navigation } from '../data/navigation';
import { isCurrentPath } from '../utils/url';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Lyra Wang — Home">
      <span class="brand-name">Lyra Wang</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: isCurrentPath(currentPath, item.href) }]}
                aria-current={isCurrentPath(currentPath, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile toggle -->
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      <span class="toggle-bar" aria-hidden="true"></span>
      <span class="toggle-bar" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav class="nav-mobile" id="mobile-menu" aria-label="Primary (mobile)" hidden>
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link-mobile', { active: isCurrentPath(currentPath, item.href) }]}
              aria-current={isCurrentPath(currentPath, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu');
  const DESKTOP_BREAKPOINT = 860;

  if (toggle && mobileMenu) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      toggle.classList.toggle('open', open);

      if (open) {
        mobileMenu.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
        // Move focus into the menu so keyboard users land in the opened content.
        mobileMenu.querySelector('a')?.focus();
      } else {
        mobileMenu.setAttribute('hidden', '');
        document.body.style.overflow = '';
      }
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Close the menu once a destination is chosen.
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Escape closes the menu and hands focus back to the toggle.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset state when the viewport grows past the mobile layout, so the menu
    // can never remain "open" (and scroll-locked) on desktop.
    window.addEventListener('resize', () => {
      if (window.innerWidth > DESKTOP_BREAKPOINT && isOpen()) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 246, 243, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .brand:hover {
    color: var(--color-accent);
  }

  /* Desktop nav */
  .nav-desktop ul {
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }
  .nav-link {
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    position: relative;
    padding-block: 0.25rem;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--color-text);
  }
  .nav-link.active {
    color: var(--color-text);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-accent);
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
  }
  .toggle-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--color-text);
    transition: transform var(--transition-base), opacity var(--transition-base);
  }
  .nav-toggle.open .toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-toggle.open .toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile nav */
  .nav-mobile {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
  }
  .nav-mobile ul {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--container-padding-x);
    gap: var(--space-1);
  }
  .nav-link-mobile {
    display: block;
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition-fast);
  }
  .nav-link-mobile:last-child {
    border-bottom: none;
  }
  .nav-link-mobile.active {
    color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .nav-desktop {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }

  /* The mobile menu must never render in the desktop layout, even if it was
     opened at a narrow width and the viewport was then resized. */
  @media (min-width: 861px) {
    .nav-mobile {
      display: none;
    }
  }
</style>
