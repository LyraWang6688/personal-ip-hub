---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Document language. The UI is English-first per the Language Contract, so
   * `en` is the default. Inline non-English text must carry its own `lang`
   * attribute instead of changing the document language.
   */
  lang?: string;
  /**
   * Set on pages that must not be treated as content entry points (currently only
   * the 404 page). Emits `noindex` and omits the self-referential canonical URL.
   */
  noindex?: boolean;
}

const {
  title = 'Lyra Wang — Personal IP Hub',
  description = 'Personal IP Hub — a public record of work, working methods, learning, and writing.',
  lang = 'en',
  noindex = false,
} = Astro.props;

// Canonical is derived from `site` in astro.config.mjs. When no site is
// configured the tag is omitted rather than emitting a relative/incorrect URL.
const canonical =
  !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// TODO (Discoverability phase): add a real og:image and then switch
// twitter:card back to `summary_large_image`. It is deliberately `summary`
// below because no Open Graph image asset exists yet — declaring
// `summary_large_image` without an image advertises an asset that is not there.
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lyra Wang" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Lyra Wang — Personal IP Hub" />
    {canonical && <meta property="og:url" content={canonical} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/fonts/newsreader-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-md);
    font-size: var(--font-size-caption);
    transition: top var(--transition-base);
  }
  .skip-link:focus {
    top: 1rem;
  }
</style>
